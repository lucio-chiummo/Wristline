<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <include layout="@layout/header" />

        <TextView
            android:id="@+id/guide_intro"
            style="@style/Text.Body.Muted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/guide_intro" />

        <TextView
            android:id="@+id/guide_nothing"
            style="@style/Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:accessibilityLiveRegion="polite"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/guide_nothing"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/guide_done"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_status"
            android:backgroundTint="@color/ready_card"
            android:orientation="vertical"
            android:padding="20dp"
            android:visibility="gone">

            <TextView
                style="@style/Text.StatusTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:text="@string/guide_done_title" />

            <TextView
                android:id="@+id/guide_done_text"
                style="@style/Text.Body.Muted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp" />

            <Button
                android:id="@+id/guide_turn_off_debugging"
                style="@style/Button.Outline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/turn_off_wireless_debugging" />

            <Button
                android:id="@+id/guide_finish"
                style="@style/Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/done" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/guide_steps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:clipToOutline="true"
            android:orientation="vertical" />

        <Button
            android:id="@+id/guide_use_computer"
            style="@style/Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:background="@null"
            android:text="@string/use_computer"
            android:textColor="@color/accent" />
    </LinearLayout>
</ScrollView>
