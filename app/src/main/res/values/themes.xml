<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Wristline" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowBackground">@color/ground</item>
        <item name="android:statusBarColor">@color/ground</item>
        <item name="android:navigationBarColor">@color/ground</item>
        <item name="android:windowLightStatusBar">@bool/light_bars</item>
        <item name="android:windowLightNavigationBar">@bool/light_bars</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:fontFamily">@font/figtree</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:colorAccent">@color/accent</item>
    </style>

    <style name="Text">
        <item name="android:fontFamily">@font/figtree</item>
        <item name="android:textColor">@color/text</item>
    </style>
    <style name="Text.Title">
        <item name="android:textSize">26sp</item>
        <item name="android:fontVariationSettings">\'wght\' 700</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>
    <style name="Text.ScreenTitle">
        <item name="android:textSize">22sp</item>
        <item name="android:fontVariationSettings">\'wght\' 700</item>
    </style>
    <style name="Text.StatusTitle">
        <item name="android:textSize">20sp</item>
        <item name="android:fontVariationSettings">\'wght\' 600</item>
    </style>
    <style name="Text.Section">
        <item name="android:textSize">14sp</item>
        <item name="android:fontVariationSettings">\'wght\' 600</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.06</item>
    </style>
    <style name="Text.RowTitle">
        <item name="android:textSize">16sp</item>
        <item name="android:fontVariationSettings">\'wght\' 600</item>
    </style>
    <style name="Text.Body">
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>
    <style name="Text.Body.Muted">
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="Text.Caption">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>
    <style name="Text.Chip">
        <item name="android:textSize">12sp</item>
        <item name="android:fontVariationSettings">\'wght\' 700</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
        <item name="android:background">@drawable/bg_chip</item>
    </style>

    <style name="Button">
        <item name="android:fontFamily">@font/figtree</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontVariationSettings">\'wght\' 700</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:paddingStart">22dp</item>
        <item name="android:paddingEnd">22dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:gravity">center</item>
    </style>
    <style name="Button.Primary">
        <item name="android:background">@drawable/bg_pill</item>
        <item name="android:backgroundTint">@color/accent</item>
        <item name="android:textColor">@color/on_accent</item>
    </style>
    <style name="Button.Amber">
        <item name="android:background">@drawable/bg_pill</item>
        <item name="android:backgroundTint">@color/amber</item>
        <item name="android:textColor">@color/on_amber</item>
    </style>
    <style name="Button.Outline">
        <item name="android:background">@drawable/bg_outline_pill</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:fontVariationSettings">\'wght\' 600</item>
    </style>

    <style name="RelaySwitch">
        <item name="android:thumb">@drawable/switch_thumb</item>
        <item name="android:track">@drawable/switch_track</item>
        <item name="android:thumbTint">@null</item>
        <item name="android:trackTint">@null</item>
        <item name="android:switchMinWidth">52dp</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:minWidth">@dimen/touch_target</item>
    </style>
</resources>
