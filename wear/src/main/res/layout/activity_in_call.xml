<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginBottom="4dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <!-- Avatar, name, app and status: shared with the incoming call screen. -->
        <include layout="@layout/call_header" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Shown only when the app's in-call notification has a mute button. -->
            <ImageButton
                android:id="@+id/mute"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_circle"
                android:backgroundTint="@color/card_high"
                android:contentDescription="@string/mute"
                android:src="@drawable/ic_mic"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/hang_up"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_circle"
                android:backgroundTint="@color/hang_up"
                android:contentDescription="@string/hang_up"
                android:src="@drawable/ic_call_end" />

            <!-- Mirrors the mute button so hang-up stays in the middle. -->
            <View
                android:id="@+id/mute_balance"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="12dp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <ImageButton
        android:id="@+id/minimise"
        android:layout_width="48dp"
        android:layout_height="40dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="4dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/minimise"
        android:src="@drawable/ic_expand_more"
        android:tint="@color/muted" />
</FrameLayout>
