<?xml version="1.0" encoding="utf-8"?>
<!-- A contact or a recent call: avatar (a favourite star on its top corner; for a call, the app's
     letter badge on its bottom corner), the name, and a detail line (the apps, or the call's
     direction and when). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="3dp"
    android:layout_marginBottom="3dp"
    android:background="@drawable/bg_pill"
    android:backgroundTint="@color/card"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:paddingStart="7dp"
    android:paddingTop="6dp"
    android:paddingEnd="12dp"
    android:paddingBottom="6dp">

    <FrameLayout
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:importantForAccessibility="noHideDescendants">

        <TextView
            android:id="@+id/avatar"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_circle"
            android:gravity="center"
            android:textColor="@color/text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/badge"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="top|end"
            android:background="@drawable/bg_badge"
            android:padding="2dp"
            android:visibility="gone" />

        <!-- W / T / S / I in the app's colour, ringed in the card colour to stand off the avatar. -->
        <TextView
            android:id="@+id/app_badge"
            android:layout_width="17dp"
            android:layout_height="17dp"
            android:layout_gravity="bottom|end"
            android:background="@drawable/bg_app_badge"
            android:gravity="center"
            android:includeFontPadding="false"
            android:textColor="@color/on_badge"
            android:textSize="9sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="7dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/muted"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
